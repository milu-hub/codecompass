<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.codecompass</groupId>
  <artifactId>codecompass-backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>codecompass-backend</name>
  <description>CodeCompass MVP backend</description>

  <properties>
    <java.version>21</java.version>
    <!-- 需要网络的测试打 @Tag("integration")，默认构建排除以保持可离线重复。
         单独运行：mvn test -Dsurefire.excludedGroups= -->
    <surefire.excludedGroups>integration</surefire.excludedGroups>
    <!-- P1：Python 解析。工具与运行时同版本，语法文件构建期生成，见下方 antlr4-maven-plugin -->
    <antlr.version>4.13.2</antlr.version>
  </properties>

  <dependencies>
    <!-- 运行时唯一依赖。注意：不要用已废弃的 spring-boot-starter-web，
         Spring Boot 4.x 起官方推荐 spring-boot-starter-webmvc。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- T4：语法级 Java 解析。刻意只用 core，不用 javaparser-symbol-solver-core
         （TASKBOOK §05 预研 2：先做语法级解析，不做符号求解）。
         实测该 artifact 的 POM 无 <dependencies> 段 —— 零传递依赖。 -->
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-core</artifactId>
      <version>3.28.2</version>
    </dependency>

    <!-- P1：Python 解析（PYTHON_ANALYZER_PLAN.md）。
         语法来源：antlr/grammars-v4，python/python3_14（Python 3.14.6 官方 PEG 语法改写），
         MIT License（Copyright (c) 2021 Robert Einhorn），文件按 commit 20efa53 钉死；
         文件路径与原文出处见 src/main/antlr4/ 与 PythonLexerBase.java 头部。
         刻意只引 runtime：生成代码在构建期由 antlr4-maven-plugin 产出，不提交。 -->
    <dependency>
      <groupId>org.antlr</groupId>
      <artifactId>antlr4-runtime</artifactId>
      <version>${antlr.version}</version>
    </dependency>

    <!-- ============ T13 MySQL 持久化基础设施（F2/F6 阶段） ============ -->

    <!-- JDBC + Flyway（版本由 Boot 4.1.1 BOM 管理，Flyway 12 + flyway-mysql） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- MySQL 驱动（生产/集成）；连接串从 DB_URL / DB_USER / DB_PASSWORD 环境变量读 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 单元测试数据库：H2 的 MySQL 兼容模式，同一套 Flyway 脚本双通 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- MyBatis-Plus 预研结论（2026-09-18）：3.5.12 的自动配置走 spring.factories，
         Spring Boot 4 已弃用该机制 → SqlSessionFactory Bean 静默缺失（实测 NoSuchBean）。
         按规格书「MyBatis-Plus（或 JPA）」条款切换 JPA 路线（FlywayMigrationTest 钉死）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>

      <!-- P1：构建期从 src/main/antlr4 生成 PythonLexer / PythonParser。
           生成物进 target/generated-sources/antlr4（不提交），与 src/main/java 同包同阶段编译，
           因此 PythonLexerBase.java 放在 src/main/java/com/codecompass/analyzer/python/parser 即可被继承。
           visitor 打开（P3 的 AST 抽取用）；listener 关掉，少生成一半死代码。 -->
      <plugin>
        <groupId>org.antlr</groupId>
        <artifactId>antlr4-maven-plugin</artifactId>
        <version>${antlr.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>antlr4</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <visitor>true</visitor>
          <listener>false</listener>
        </configuration>
      </plugin>

      <!--
        护栏：禁止 Jackson 2 的 databind/core 被传递依赖拖进 classpath。
        Jackson 3 的核心类已迁到 tools.jackson.*，注解仍留在
        com.fasterxml.jackson.annotation.*，且 Jackson 3 的 databind 自身依赖
        com.fasterxml.jackson.core:jackson-annotations —— 所以绝不能连 annotations 一起禁。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>ban-jackson2</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                    <exclude>com.fasterxml.jackson.core:jackson-core</exclude>
                  </excludes>
                  <message>
                    检测到 Jackson 2 的 databind/core。Jackson 3 已迁到 tools.jackson.*，
                    请改用 tools.jackson.databind.json.JsonMapper。
                    注意：jackson-annotations 不在此禁令内（Jackson 3 依赖它）。
                  </message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
